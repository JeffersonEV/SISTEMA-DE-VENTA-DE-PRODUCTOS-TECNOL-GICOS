{
  "info": {
    "_postman_id": "2f3c8b0e-9d7a-4b6f-8c1e-techstore-001",
    "name": "TechStore API",
    "description": "Sistema de Venta de Productos Tecnologicos - API REST Spring Boot + JWT. Variables: baseUrl=http://localhost:8080/api , token (se guarda automaticamente tras el login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Registro de cliente",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/registro", "host": ["{{baseUrl}}"], "path": ["auth", "registro"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"Clave123*\"\n}"
            }
          }
        },
        {
          "name": "Login (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  pm.test('Token JWT guardado automaticamente', () => pm.expect(body.token).to.not.be.empty);",
                  "} else {",
                  "  pm.test('Login fallido', () => { throw new Error('No se obtuvo token'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techstore.com\",\n  \"password\": \"Admin123*\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        { "name": "Listar categorias", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] } } },
        { "name": "Obtener categoria por id", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/categorias/1", "host": ["{{baseUrl}}"], "path": ["categorias", "1"] } } },
        { "name": "Crear categoria (ADMIN)", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Tablets\",\n  \"descripcion\": \"Tablets y convertibles\"\n}" } } },
        { "name": "Actualizar categoria (ADMIN)", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/categorias/1", "host": ["{{baseUrl}}"], "path": ["categorias", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Laptops\",\n  \"descripcion\": \"Computadoras portatiles\"\n}" } } },
        { "name": "Eliminar categoria (ADMIN)", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/categorias/99", "host": ["{{baseUrl}}"], "path": ["categorias", "99"] } } }
      ]
    },
    {
      "name": "Productos",
      "item": [
        { "name": "Listar productos (filtros+paginacion)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/productos?nombre=laptop&categoriaId=&minPrecio=&maxPrecio=&page=0&size=12", "host": ["{{baseUrl}}"], "path": ["productos"], "query": [ { "key": "nombre", "value": "laptop" }, { "key": "categoriaId", "value": "" }, { "key": "minPrecio", "value": "" }, { "key": "maxPrecio", "value": "" }, { "key": "page", "value": "0" }, { "key": "size", "value": "12" } ] } } },
        { "name": "Obtener producto por id", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/productos/1", "host": ["{{baseUrl}}"], "path": ["productos", "1"] } } },
        { "name": "Crear producto (ADMIN)", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Tablet Samsung S9\",\n  \"descripcion\": \"12.4 QHD 120Hz\",\n  \"precio\": 2599.00,\n  \"stock\": 15,\n  \"marca\": \"Samsung\",\n  \"imagenUrl\": \"https://picsum.photos/seed/tablet/400/300\",\n  \"activo\": true,\n  \"categoriaId\": 1\n}" } } },
        { "name": "Actualizar producto (ADMIN)", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/productos/1", "host": ["{{baseUrl}}"], "path": ["productos", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Laptop Lenovo IdeaPad 3\",\n  \"precio\": 4499.00,\n  \"stock\": 10,\n  \"marca\": \"Lenovo\",\n  \"activo\": true,\n  \"categoriaId\": 1\n}" } } },
        { "name": "Eliminar producto (ADMIN)", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/productos/99", "host": ["{{baseUrl}}"], "path": ["productos", "99"] } } }
      ]
    },
    {
      "name": "Pedidos (Cliente)",
      "item": [
        { "name": "Crear pedido", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }, "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productoId\": 1, \"cantidad\": 2 },\n    { \"productoId\": 4, \"cantidad\": 1 }\n  ]\n}" } } },
        { "name": "Mis pedidos", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/pedidos/mis-pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos", "mis-pedidos"] } } },
        { "name": "Obtener pedido por id", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/pedidos/1", "host": ["{{baseUrl}}"], "path": ["pedidos", "1"] } } },
        { "name": "Cancelar pedido", "request": { "method": "PATCH", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/pedidos/1/cancelar", "host": ["{{baseUrl}}"], "path": ["pedidos", "1", "cancelar"] } } }
      ]
    },
    {
      "name": "Panel Administrativo",
      "item": [
        { "name": "Listar todos los pedidos (filtros)", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/pedidos?estado=&usuarioId=&desde=&hasta=&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["admin", "pedidos"] } } },
        { "name": "Cambiar estado de pedido", "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/pedidos/1/estado", "host": ["{{baseUrl}}"], "path": ["admin", "pedidos", "1", "estado"] }, "body": { "mode": "raw", "raw": "{\n  \"estado\": \"PAGADO\"\n}" } } },
        { "name": "Listar usuarios (paginado)", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios"] } } },
        { "name": "Crear usuario", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Lopez\",\n  \"email\": \"ana@test.com\",\n  \"password\": \"Clave123*\",\n  \"rol\": \"CLIENTE\"\n}" } } },
        { "name": "Actualizar usuario", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios/1", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Admin\",\n  \"apellido\": \"TechStore\",\n  \"email\": \"admin@techstore.com\"\n}" } } },
        { "name": "Activar/Desactivar usuario", "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios/2/activo", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios", "2", "activo"] }, "body": { "mode": "raw", "raw": "{\n  \"activo\": true\n}" } } },
        { "name": "Cambiar rol de usuario", "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios/2/rol", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios", "2", "rol"] }, "body": { "mode": "raw", "raw": "{\n  \"rol\": \"CLIENTE\"\n}" } } },
        { "name": "Eliminar usuario", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/usuarios/99", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios", "99"] } } }
      ]
    },
    {
      "name": "Usuarios (CRUD /api/usuarios)",
      "item": [
        { "name": "Listar usuarios", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] } } },
        { "name": "Obtener usuario", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/usuarios/1", "host": ["{{baseUrl}}"], "path": ["usuarios", "1"] } } },
        { "name": "Crear usuario", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Ruiz\",\n  \"email\": \"carlos@test.com\",\n  \"password\": \"Clave123*\",\n  \"rol\": \"CLIENTE\"\n}" } } },
        { "name": "Actualizar usuario", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/usuarios/1", "host": ["{{baseUrl}}"], "path": ["usuarios", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Admin\",\n  \"apellido\": \"TechStore\",\n  \"email\": \"admin@techstore.com\"\n}" } } },
        { "name": "Eliminar usuario", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/usuarios/99", "host": ["{{baseUrl}}"], "path": ["usuarios", "99"] } } }
      ]
    },
    {
      "name": "Reportes (ADMIN)",
      "item": [
        { "name": "Resumen", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/reportes/resumen", "host": ["{{baseUrl}}"], "path": ["admin", "reportes", "resumen"] } } },
        { "name": "Top productos", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/reportes/top-productos?limite=5", "host": ["{{baseUrl}}"], "path": ["admin", "reportes", "top-productos"] } } },
        { "name": "Ventas por categoria", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/reportes/ventas-por-categoria", "host": ["{{baseUrl}}"], "path": ["admin", "reportes", "ventas-por-categoria"] } } },
        { "name": "Stock bajo", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/admin/reportes/stock-bajo?umbral=5", "host": ["{{baseUrl}}"], "path": ["admin", "reportes", "stock-bajo"] } } }
      ]
    }
  ],
  "event": []
}